# Copy to .env. NEVER commit it. All secrets stay on the backend.

# --- Demo mode (default) ---
# With no keys set, the app runs a fully working SIMULATED flow: fake position,
# deterministic intent parser and a simulated signed order. Labeled on-glasses.
DEMO_MODE=true

# --- Hyperliquid testnet (real write path) ---
# Public address to watch. Use the MASTER/SUB ACCOUNT address, not the agent wallet.
HYPERLIQUID_ADDRESS=
# Private key of a testnet API (agent) wallet with NO withdrawal rights.
# Mint one at https://app.hyperliquid-testnet.xyz/API
HYPERLIQUID_AGENT_PRIVATE_KEY=
HYPERLIQUID_NETWORK=testnet

# --- Speech to text (optional; falls back to deterministic demo parser) ---
# OpenAI-compatible transcription endpoint; empty = deterministic parser.
OPENAI_API_KEY=
STT_MODEL=gpt-4o-mini-transcribe

# --- Intent parsing (optional; falls back to deterministic parser) ---
# Anthropic or OpenRouter compatible Messages API.
ANTHROPIC_API_KEY=
INTENT_MODEL=claude-3-5-haiku-latest
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Optional Telegram bridge (Track 01 + Best Telegram $1,000 prize) ---
# Bot token from @BotFather. Long polling, no webhook/TLS needed.
TELEGRAM_BOT_TOKEN=

# --- Backend ---
PORT=8787
# Origin allowed by the WebView / simulator whitelist (app.json networking).
ALLOWED_ORIGIN=http://localhost:5173
